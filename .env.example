# =============================================================================
# EduStream AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# In production (AWS App Runner), set these as environment variables directly
# in the App Runner service configuration — do NOT use a .env file in prod.

# --- Groq API Keys (REQUIRED) ------------------------------------------------
# Supports multiple comma-separated keys for round-robin rotation.
# This increases your daily token limit and provides automatic failover.
# Example with 3 keys:
#   GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Example with 1 key:
#   GROQ_API_KEYS=gsk_yourkeyhere
GROQ_API_KEYS=gsk_your_key_1,gsk_your_key_2,gsk_your_key_3

# Alternative single-key variable (used if GROQ_API_KEYS is not set):
# GROQ_API_KEY=gsk_your_single_key_here

# --- CORS Configuration (OPTIONAL) ------------------------------------------
# Restrict which origins can call the API.
# In production, set this to your App Runner URL to lock down CORS.
# Leave as "*" for development or if frontend and backend share the same origin.
# Example: ALLOWED_ORIGINS=https://abcd1234.ap-south-1.awsapprunner.com
ALLOWED_ORIGINS=*

# --- Application Settings (OPTIONAL) ----------------------------------------
# Uvicorn log level: debug, info, warning, error, critical
LOG_LEVEL=info

# Number of Uvicorn workers (1 recommended for App Runner 0.25 vCPU)
WORKERS=1
